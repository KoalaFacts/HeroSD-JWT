<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net11.0 is built (the CI matrix builds every project per framework) but not run:
         BenchmarkDotNet 0.15.8 cannot run on .NET 11, and perform-benchmarks.yml excludes it. -->
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HeroSdJwt\HeroSdJwt.csproj" />
  </ItemGroup>

</Project>
