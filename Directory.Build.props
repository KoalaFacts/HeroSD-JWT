<Project>
  <PropertyGroup>
    <!-- Default multi-targeting for all projects -->
    <!-- Individual projects can override if they need specific frameworks (e.g., source generators using netstandard2.0) -->
    <SupportedTargetFrameworks>net8.0;net9.0;net10.0</SupportedTargetFrameworks>

    <!-- Pin SDKs alongside global.json and package locks; SDK updates can change implicit ILLink dependencies. -->
    <SupportedSdkVersions>8.0.426;9.0.319;10.0.402</SupportedSdkVersions>

    <!-- Enable NuGet package lock files for reproducible builds -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>

    <!-- Enforce EditorConfig code style during build so style violations fail when TreatWarningsAsErrors=true -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Compiler and build settings -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringCompilation>true</RunAnalyzersDuringCompilation>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Source Link and reproducible builds -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Source Link is included in .NET SDK 8+. Use the patched SDK copy rather than overriding it. -->

  <!-- Test and Benchmark project settings -->
  <PropertyGroup
    Condition="$(MSBuildProjectName.Contains('Tests')) Or $(MSBuildProjectName.Contains('Benchmarks'))">
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- CS1591: Missing XML comment for publicly visible type or member -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
