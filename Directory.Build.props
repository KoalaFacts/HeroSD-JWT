<Project>
  <PropertyGroup>
    <!-- Enable NuGet package lock files for reproducible builds -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Restore lock file mode: LockedMode ensures lock file is up to date -->
    <!-- Only enforce in CI if NUGET_LOCKED_MODE is explicitly set to 'true' -->
    <!-- This allows the first CI run to generate lock files without failing -->
    <RestoreLockedMode Condition="'$(NUGET_LOCKED_MODE)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <!-- Default target frameworks for all projects -->
  <PropertyGroup>
    <!-- Default multi-targeting for all projects -->
    <!-- Individual projects can override if they need specific frameworks (e.g., source generators using netstandard2.0) -->
    <SupportedTargetFrameworks>net8.0;net9.0;net10.0</SupportedTargetFrameworks>
  </PropertyGroup>
</Project>
