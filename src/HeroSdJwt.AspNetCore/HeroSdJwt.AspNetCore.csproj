<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <RootNamespace>HeroSdJwt.AspNetCore</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package Metadata -->
    <PackageId>HeroSD-JWT.AspNetCore</PackageId>

    <!-- Version: Placeholder for local builds. CI overrides this with -p:Version=${{ inputs.version }} during releases. -->
    <Version>1.0.0</Version>

    <Authors>KoalaFacts</Authors>
    <Company>KoalaFacts</Company>
    <Product>HeroSD-JWT.AspNetCore</Product>
    <Description>ASP.NET Core integration for HeroSD-JWT. Provides authentication middleware, dependency injection extensions, and automatic JWT verification for ASP.NET Core applications using SD-JWT (Selective Disclosure for JSON Web Tokens).</Description>
    <PackageTags>sd-jwt;aspnetcore;authentication;middleware;jwt;selective-disclosure;verifiable-credentials;security</PackageTags>
    <PackageProjectUrl>https://github.com/KoalaFacts/HeroSD-JWT</PackageProjectUrl>
    <RepositoryUrl>https://github.com/KoalaFacts/HeroSD-JWT</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright (c) 2025 KoalaFacts</Copyright>

    <!-- Release Notes: CI auto-generates from CHANGELOG.md via -p:PackageReleaseNotes during releases.
         For local builds, this provides a fallback URL to the releases page. -->
    <PackageReleaseNotes>See release notes: https://github.com/KoalaFacts/HeroSD-JWT/releases</PackageReleaseNotes>

    <!-- Source Link for debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Package Validation -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\HeroSdJwt\HeroSdJwt.csproj" />
  </ItemGroup>

  <!-- ASP.NET Core Dependencies -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Additional Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.0" />
  </ItemGroup>

  <!-- Source Link for debugging support -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Include icon in NuGet package -->
  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
