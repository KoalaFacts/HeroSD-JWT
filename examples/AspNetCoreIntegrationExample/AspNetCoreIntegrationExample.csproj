<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>$(SupportedTargetFrameworks)</TargetFrameworks>
    <NoWarn>$(NoWarn);IDE0005</NoWarn>
  </PropertyGroup>

  <!-- Framework-specific package references -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">
    <!-- Keep the OpenAPI 2.x dependency on the patched line; .NET 9 requires OpenAPI 1.x. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- .NET 8: Use Swashbuckle (AddOpenApi requires .NET 9+) -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <!-- .NET 9: Use Microsoft.AspNetCore.OpenApi 9.x -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- .NET 10: Use Microsoft.AspNetCore.OpenApi 10.x -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
		<PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
		<ProjectReference Include="..\..\src\HeroSdJwt.AspNetCore\HeroSdJwt.AspNetCore.csproj" />
  </ItemGroup>

</Project>
